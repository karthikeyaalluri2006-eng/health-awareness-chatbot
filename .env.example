# ==============================================================================
# HealthAware AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Application Environment (development, production, testing)
APP_ENV=development
APP_NAME=HealthAware AI

# Database Configuration
# Default is local SQLite: sqlite:///./data/healthaware.db
DATABASE_URL=sqlite:///./data/healthaware.db

# Vector Database Configuration (Optional for PostgreSQL+pgvector)
# VECTOR_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/healthaware_vectors

# LLM Configuration
# Options: offline (default built-in engine), openai, gemini, ollama
LLM_PROVIDER=offline
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Embedding Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Security & Secrets
AUTH_SECRET=CHANGE_ME_use_a_long_random_secret_string
JWT_SECRET=CHANGE_ME_use_a_different_long_random_secret
ENCRYPTION_KEY=CHANGE_ME_base64_encoded_32_byte_key

# Healthcare Directory & Navigation API (Optional, uses built-in directory by default)
MAPS_API_KEY=

# Speech Recognition API (Optional, uses built-in audio handler by default)
SPEECH_API_KEY=

# Notification Providers (Mock, Twilio, SendGrid)
NOTIFICATION_PROVIDER=mock
EMAIL_API_KEY=
SMS_API_KEY=

# Wearable Integrations (OAuth credentials for real adapters)
WEARABLE_PROVIDER=mock
WEARABLE_CLIENT_ID=
WEARABLE_CLIENT_SECRET=

# EHR/EMR Integration (FHIR standard)
EHR_PROVIDER=mock
EHR_CLIENT_ID=
EHR_CLIENT_SECRET=
